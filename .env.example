# Flask
FLASK_ENV=development
FLASK_DEBUG=1

# Firebase (optional — app uses in-memory storage when unset)
# Option A: point to downloaded service account JSON (recommended)
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# Top-level Firestore collection name (default: reviews)
FIREBASE_COLLECTION=feedback_pulse_v2

# Option B: set individual fields instead of using a JSON file
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_CERT_URL=
